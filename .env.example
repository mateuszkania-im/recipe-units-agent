# Copy to .env and fill in. Never commit .env.
# One of these is enough. OpenRouter is preferred when both are set.
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=

# Optional model overrides (Mastra model router ids, "provider/model").
# Defaults: a cheap and a strong model, chosen by which key is set.
# MODEL_CHEAP=openrouter/anthropic/claude-haiku-5.5
# MODEL_STRONG=openrouter/anthropic/claude-sonnet-5.5

# Optional Langfuse tracing. Disabled unless both keys are set.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
